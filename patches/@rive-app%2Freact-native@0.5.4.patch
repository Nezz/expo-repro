@@ -0,0 +1,84 @@
+package com.margelo.nitro.rive
+
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import android.view.Choreographer
+import app.rive.core.CommandQueue
+
+/**
+ * Polls the shared CommandQueue, whose suspend calls (file loads, view-model
+ * lookups) and flows only complete when it is polled.
+ *
+ * It polls on every vsync while a view's render loop runs or shortly after a
+ * worker lookup (a file load or view update), and on a slow timer otherwise,
+ * so a screen of paused views asks for no vsync at all.
+ *
+ * Main thread only, except [markBusy].
+ */
+internal object RiveMessagePump {
+  private const val TAG = "RiveMessagePump"
+  private const val BUSY_POLL_MS = 1_000L
+  private const val IDLE_POLL_MS = 100L
+
+  private val handler = Handler(Looper.getMainLooper())
+  private var worker: CommandQueue? = null
+  private var activeViewLoops = 0
+  private var busyUntilMs = 0L
+  private var scheduled = false
+  private var scheduledOnVsync = false
+
+  private val frameCallback = Choreographer.FrameCallback { tick() }
+  private val idleRunnable = Runnable { tick() }
+
+  fun start(worker: CommandQueue) {
+    handler.post {
+      this.worker = worker
+      schedule()
+    }
+  }
+
+  // Any thread.
+  fun markBusy() {
+    handler.post {
+      busyUntilMs = SystemClock.uptimeMillis() + BUSY_POLL_MS
+      schedule()
+    }
+  }
+
+  fun viewLoopStarted() {
+    activeViewLoops++
+    schedule()
+  }
+
+  fun viewLoopStopped() {
+    activeViewLoops--
+  }
+
+  private fun tick() {
+    scheduled = false
+    try {
+      worker?.pollMessages()
+    } catch (e: Exception) {
+      Log.e(TAG, "pollMessages error", e)
+    }
+    schedule()
+  }
+
+  private fun schedule() {
+    if (worker == null) return
+    val onVsync = activeViewLoops > 0 || SystemClock.uptimeMillis() < busyUntilMs
+    if (scheduled) {
+      if (scheduledOnVsync || !onVsync) return
+      handler.removeCallbacks(idleRunnable)
+    }
+    scheduled = true
+    scheduledOnVsync = onVsync
+    if (onVsync) {
+      Choreographer.getInstance().postFrameCallback(frameCallback)
+    } else {
+      handler.postDelayed(idleRunnable, IDLE_POLL_MS)
+    }
+  }
+}
