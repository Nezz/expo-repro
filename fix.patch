+  private static void setFontVariationSettings(Paint paint, String settings) {
+    Typeface base = paint.getTypeface();
+    synchronized (variationTypefaces) {
+      Map<String, Typeface> bySettings = variationTypefaces.get(base);
+      if (bySettings == null) {
+        bySettings = new HashMap<>();
+        variationTypefaces.put(base, bySettings);
+      }
+      Typeface variation = bySettings.get(settings);
+      if (variation != null) {
+        paint.setTypeface(variation);
+        return;
+      }
+      paint.setFontVariationSettings(settings);
+      bySettings.put(settings, paint.getTypeface());
+    }
+  }
