{
  "name": "ReanimatedIdle",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "fix:worklets": "patch -p1 -d node_modules/react-native-worklets < patches/worklets-on-demand-loop.patch",
    "fix:mappers": "patch -p1 -d node_modules/react-native-reanimated < patches/reanimated-on-demand-mappers.patch",
    "fix:interval": "patch -p1 -d node_modules/react-native-reanimated < patches/reanimated-settled-props-interval.patch"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
